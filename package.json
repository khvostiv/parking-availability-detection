{
  "name": "parking-availability-detection",
  "version": "1.0.0",
  "description": "Find nearby parking on Google Maps and check lot occupancy from a live video feed.",
  "main": "app.js",
  "scripts": {
    "start": "concurrently -n flask,web -c blue,green \"node scripts/run-flask.js\" \"node app.js\"",
    "start:web": "node app.js",
    "start:flask": "node scripts/run-flask.js",
    "pick-spaces": "python3 backend/tools/pick_spaces.py",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "parking",
    "flask",
    "maps"
  ],
  "author": "Vasilina Khvostikova",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
